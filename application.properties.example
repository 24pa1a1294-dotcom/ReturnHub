# ===================================================================
# Return Hub - Example application.properties
# Copy this file to application.properties or configure environment variables.
# No real passwords are stored in this file.
# ===================================================================

spring.application.name=Return Hub - Lost and Found

# Database Configuration (MySQL)
# Default connects to localhost:3306/returnhub_db
spring.datasource.url=jdbc:mysql://localhost:3306/returnhub_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Alternatively, configure via system environment variables:
# DB_URL=jdbc:mysql://your-server:3306/returnhub_db
# DB_USERNAME=your_mysql_username
# DB_PASSWORD=your_mysql_password

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=true

# File Uploads (Item Images)
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
returnhub.upload.dir=uploads

# Server Port
server.port=8080
